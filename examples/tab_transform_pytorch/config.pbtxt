name: "tab_transform_pytorch"
backend: "python"
max_batch_size: 4

input [
    {
        name: "INPUT0"
        data_type: TYPE_INT64
        dims: [ 5 ]
    }
]
input [
    {
        name: "INPUT1"
        data_type: TYPE_FP32
        dims: [ 10 ]
    }
]
output [
    {
        name: "OUTPUT0"
        data_type: TYPE_FP32
        dims: [ 1 ]
    }
]

instance_group [
    { 
        kind: KIND_GPU 
        count: 1
        gpus: [ 0 ]
    }
]
